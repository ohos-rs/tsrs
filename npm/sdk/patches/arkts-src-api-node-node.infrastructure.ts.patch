+/** ArkTS parser identity and Kit source ranges carried by protocol 10. */
+export function readEtsOptionsJSON(data: DataView): string {
+    const index = data.getUint32(HEADER_OFFSET_ETS_OPTIONS, true);
+    if (index === 0xFFFFFFFF) return "";
+    const table = data.getUint32(HEADER_OFFSET_STRING_TABLE_OFFSETS, true) + index * 4;
+    const start = data.getUint32(table, true);
+    const end = data.getUint32(table + 4, true);
+    const offset = data.getUint32(HEADER_OFFSET_STRING_TABLE, true);
+    return new globalThis.TextDecoder().decode(new Uint8Array(data.buffer, data.byteOffset + offset + start, end - start));
